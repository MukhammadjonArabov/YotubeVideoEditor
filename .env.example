# Copy this file to .env and fill in the values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=          # model used for script writing / analysis (check current Gemini docs)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite   # used when the main model is busy (503)
GEMINI_IMAGE_MODEL=         # model used for image generation
YOUTUBE_API_KEY=            # YouTube Data API v3 key, for channel research

TTS_PROVIDER=edge           # edge | gemini | elevenlabs
EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural
EDGE_TTS_RATE=+0%
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
ELEVENLABS_API_KEY=         # optional, only if TTS_PROVIDER=elevenlabs
ELEVENLABS_VOICE_ID=

# Image generation: cloudflare (free daily quota) | gemini (paid)
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=      # Cloudflare dashboard -> Workers AI -> "Use REST API" shows it
CLOUDFLARE_API_TOKEN=       # token made with the "Workers AI" template
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4    # 1..8; more steps = nicer image, uses more of the free quota
IMAGE_FALLBACK_PROVIDERS=   # backup providers used when the main one's daily limit is over (comma separated)

FFMPEG_PATH=ffmpeg          # optional: if not found, the ffmpeg bundled with imageio-ffmpeg is used
POLICY_CHECK_INTERVAL_DAYS=7
MAX_IMAGES_PER_PROJECT=100
IMAGE_CONCURRENCY=3         # scenes drawn at the same time
TTS_CONCURRENCY=4           # voice-overs made at the same time
SUBSCRIBE_CTA=True          # animated Subscribe button in the video
SUBSCRIBE_CTA_AT_SEC=40     # mid-video button appears after this many seconds
SUBSCRIBE_CTA_END=True      # second button in the last scene
RENDER_WORKERS=0            # parallel ffmpeg clips; 0 = auto (half the CPU threads)
DATABASE_URL=               # optional, e.g. postgres://user:pass@localhost:5432/autoexplainer
